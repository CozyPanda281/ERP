# ============================================================================
# ERP Platform - environment configuration (copy to .env and fill in)
# ============================================================================

# --- App ---
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=https://app.your-domain.com
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=erp-platform

# --- Database ---
# Root user (postgres) — used ONLY to run migrations and create the app role
DB_ROOT_USER=postgres
DB_ROOT_PASSWORD=change-me-strong
# Application role (created by phase10 migration; must match DB_PASSWORD below)
DB_USER=erp_app
DB_PASSWORD=change-me-strong
DB_NAME=erp
DB_HOST=db
DB_PORT=5432
DB_SSL=false
DB_MAX_CONNECTIONS=20
# Set true on the first deploy; the API runs migrations before starting
RUN_MIGRATIONS=true

# --- Encryption (AES-256-GCM master key for PII columns) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ENCRYPTION_KEY=change-me

# --- Storage ---
# Local filesystem; files land under STORAGE_PATH and are served at /uploads/
# S3-compatible backends are a roadmap item
STORAGE_PATH=/app/uploads

# --- Redis (optional; job queue falls back to inline execution when absent) ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# --- Email (SMTP) ---
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
SMTP_FROM="ERP Platform <no-reply@your-domain.com>"

# --- Seed (npm run seed — creates the platform superadmin) ---
# Optional: without them a random password is generated and printed once
SEED_ADMIN_EMAIL=admin@erp.com
SEED_ADMIN_PASSWORD=change-me-strong

# --- Web (frontend) ---
WEB_PORT=80
